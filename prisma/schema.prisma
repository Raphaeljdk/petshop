// Pet Hub - Schema do Sistema de Pet Shop
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("CLIENTE") // ADMIN | CLIENTE
  clienteId String?  @unique
  siggmaCliCod Int?    @unique // vínculo com o cliente oficial no Siggma
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  adminInvitations AdminInvitation[]
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  cpfCnpj   String?  @unique
  email     String?  @unique
  endereco  String?
  cep       String?  // CEP para cálculo de frete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets         Pet[]
  agendamentos Agendamento[]
  vendas       Venda[]
  cuponsUsados CupomUso[]
  user         User?
}

model Pet {
  id          String   @id @default(cuid())
  nome        String
  especie     String
  raca        String?
  idade       String?
  peso        String?
  fotoUrl     String?
  observacoes String?
  clienteId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processos    Processo[]
  agendamentos Agendamento[]
}

model Processo {
  id              String   @id @default(cuid())
  petId           String
  status          String   @default("novo")
  servico         String
  responsavel     String?
  anamnese        String?
  inicioAtendimento DateTime?
  fimAtendimento   DateTime?
  valorServico    Float    @default(0)
  notificadoEm    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  notificacoes Notificacao[]
}

model Agendamento {
  id        String   @id @default(cuid())
  petId     String
  clienteId String
  servico   String
  dataHora  DateTime
  status    String   @default("agendado")
  observacoes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pet     Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model Produto {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  categoria   String
  preco       Float
  precoPromo  Float?
  estoque     Int      @default(0)
  sku         String?
  zettaProCod Int?     @unique // vínculo com PRODUTOS.pro_cod no ERP Zetta
  mlItemId    String?
  amazonAsin  String?
  imageUrl    String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  itensVenda ItemVenda[]
}

model Venda {
  id         String   @id @default(cuid())
  clienteId String?
  total      Float
  subtotalProdutos Float?
  cupomId    String?
  cupomCodigo String?
  descontoCupom Float @default(0)
  canal      String   @default("loja")
  status     String   @default("concluida")
  observacoes String?
  tipoEntrega     String?
  valorFrete      Float?   @default(0)
  cepEntrega      String?
  enderecoEntrega String?
  prazoEntrega    String?
  codigoRastreio  String?
  statusEntrega   String?  @default("pendente")
  mercadoPagoId String?
  mercadoPagoStatus String?
  mercadoPagoPaymentUrl String?
  mercadoPagoQrCode String?
  mercadoPagoPixExpiresAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cliente Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  cupom   Cupom?    @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  usoCupom CupomUso?
  itens   ItemVenda[]

  @@index([cupomId])
}

model ItemVenda {
  id        String  @id @default(cuid())
  vendaId   String
  produtoId String
  quantidade Int
  precoUnit Float
  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Cupom {
  id                    String   @id @default(cuid())
  codigo                String   @unique
  descricao             String?
  tipoDesconto          String   @default("percentual") // percentual | fixo
  valor                 Float
  valorMinimo           Float    @default(0)
  limiteUsos            Int?
  limitePorCliente      Int      @default(1)
  inicioEm              DateTime?
  fimEm                 DateTime?
  ativo                  Boolean  @default(true)
  influenciadorNome     String?
  influenciadorContato  String?
  comissaoPercentual    Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  vendas                Venda[]
  usos                   CupomUso[]

  @@index([ativo, fimEm])
}

model CupomUso {
  id         String   @id @default(cuid())
  cupomId    String
  vendaId    String   @unique
  clienteId  String?
  codigo     String
  desconto   Float
  comissao   Float    @default(0)
  createdAt  DateTime @default(now())
  cupom      Cupom    @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  venda      Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([cupomId, createdAt])
  @@index([clienteId])
}

model Notificacao {
  id        String   @id @default(cuid())
  tipo      String
  destino   String
  mensagem  String
  processoId String?
  status    String   @default("pendente")
  createdAt DateTime @default(now())
  enviadaEm DateTime?
  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
}

model Integracao {
  id        String   @id @default(cuid())
  plataforma String
  ativo     Boolean  @default(false)
  token     String?
  sellerId  String?
  domain    String?
  ultimaSync DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoFrete {
  id String @id @default(cuid())
  entregaPropriaAtiva Boolean @default(true)
  entregaPropriaValor Float @default(20.00)
  entregaPropriaPrazo String @default("1-2 dias úteis")
  entregaPropriaCepInicial String @default("02000-000")
  entregaPropriaCepFinal String @default("02999-999")
  sedexAtivo Boolean @default(false)
  sedexPrazo String @default("3-5 dias úteis")
  retiradaAtiva Boolean @default(true)
  retiradaPrazo String @default("Pronto em 2h")
  retiradaEndereco String @default("Av. Água Fria, 1647 — Santana, São Paulo/SP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoPagamento {
  id String @id @default(cuid())
  mercadoPagoAtivo Boolean @default(false)
  mercadoPagoAccessToken String?
  mercadoPagoPublicKey String?
  mercadoPagoSandbox Boolean @default(true)
  pixAtivo Boolean @default(true)
  cartaoAtivo Boolean @default(true)
  boletoAtivo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInvitation {
  id          String   @id @default(cuid())
  email       String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model AuthAttempt {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
