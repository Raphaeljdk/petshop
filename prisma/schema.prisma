// Pet Hub - Schema do Sistema de Pet Shop
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("CLIENTE") // ADMIN | CLIENTE
  clienteId String?  @unique
  siggmaCliCod Int?    @unique // vínculo com o cliente oficial no Siggma
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  adminInvitations AdminInvitation[]
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  cpfCnpj   String?  @unique
  email     String?  @unique
  importacaoLegadoId String? @unique // referencia historica, sem chamadas ao sistema antigo
  ativo Boolean @default(true)
  endereco  String?
  cep       String?  // CEP para cálculo de frete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets         Pet[]
  agendamentos Agendamento[]
  vendas       Venda[]
  cuponsUsados CupomUso[]
  user         User?
  preferences CustomerPreference[]
  petProfiles CustomerPetProfile[]
  reviews ProductReview[]
  bookingRequests BookingRequest[]
  redemptions LoyaltyRedemption[]
}

model Pet {
  id          String   @id @default(cuid())
  nome        String
  especie     String
  raca        String?
  idade       String?
  peso        String?
  fotoUrl     String?
  observacoes String?
  clienteId   String
  importacaoLegadoId String? @unique
  ativo Boolean @default(true)
  porte String?
  sexo String?
  nascimento DateTime?
  cor String?
  castrado Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processos    Processo[]
  agendamentos Agendamento[]
}

model Processo {
  id              String   @id @default(cuid())
  petId           String
  status          String   @default("novo")
  servico         String
  responsavel     String?
  anamnese        String?
  requiresFicha Boolean @default(false) // fluxos estéticos novos, preserva processos legados
  inicioAtendimento DateTime?
  fimAtendimento   DateTime?
  valorServico    Float    @default(0)
  notificadoEm    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  notificacoes Notificacao[]
  ficha AtendimentoFicha?
}

model Agendamento {
  id        String   @id @default(cuid())
  petId     String
  clienteId String
  servico   String
  categoria String @default("Gerais")
  dataHora  DateTime
  status    String   @default("agendado")
  observacoes String?
  profissionalId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profissional ProfissionalAgenda? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  pet     Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@index([dataHora, status])
  @@index([profissionalId, dataHora])
}

// Profissionais da agenda: independentes de contas de login; registros antigos continuam sem atribuição.
model ProfissionalAgenda {
  id String @id @default(cuid())
  nome String
  especialidades String?
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agendamentos Agendamento[]
}

model Produto {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  categoria   String
  preco       Float
  precoPromo  Float?
  estoque     Int      @default(0) // saldo operacional usado no checkout
  estoqueHub  Int      @default(0)
  estoqueZetta Int     @default(0)
  estoqueMercadoLivre Int @default(0)
  estoqueAmazon Int    @default(0)
  estoqueIlimitado Boolean @default(false)
  sku         String?
  zettaProCod Int?     @unique // vínculo com PRODUTOS.pro_cod no ERP Zetta
  mlItemId    String?
  amazonAsin  String?
  imageUrl    String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ncm         String?
  cest        String?
  cfop        String?
  origem      String? @default("0")
  cst         String?
  csosn       String?
  unidadeFiscal String? @default("UN")
  // Classificação fiscal adicional: opcional, sem presumir valores ou tributação.
  // O contador deve conferir CSTs, GTIN e tratamento por operação/destino.
  gtinFiscal String?
  pisCst String?
  cofinsCst String?
  ipiCst String?
  ibsCbsCst String?
  ibsCbsClassTrib String?
  itensVenda ItemVenda[]
  preferences CustomerPreference[]
  reviews ProductReview[]
}

model Venda {
  id         String   @id @default(cuid())
  clienteId String?
  total      Float
  creditoPresenteCentavos Int @default(0)
  subtotalProdutos Float?
  cupomId    String?
  cupomCodigo String?
  descontoCupom Float @default(0)
  canal      String   @default("loja")
  status     String   @default("concluida")
  marketplaceOrderId String? @unique
  marketplaceBuyerDocument String?
  marketplaceBuyerName String?
  marketplaceStockAppliedAt DateTime?
  observacoes String?
  tipoEntrega     String?
  valorFrete      Float?   @default(0)
  cepEntrega      String?
  enderecoEntrega String?
  prazoEntrega    String?
  codigoRastreio  String?
  statusEntrega   String?  @default("pendente")
  mercadoPagoId String?
  mercadoPagoStatus String?
  mercadoPagoPaymentUrl String?
  mercadoPagoQrCode String?
  mercadoPagoPixExpiresAt DateTime?
  siggmaGuid String? @unique
  siggmaImportStatus String?
  siggmaImportedAt DateTime?
  siggmaImportError String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cliente Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  cupom   Cupom?    @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  usoCupom CupomUso?
  itens   ItemVenda[]
  reviews ProductReview[]
  notaFiscal NotaFiscal?
  presenteUsado PortalGiftRedemption?

  @@index([cupomId])
}

model ItemVenda {
  id        String  @id @default(cuid())
  vendaId   String
  produtoId String
  quantidade Int
  precoUnit Float
  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Cupom {
  id                    String   @id @default(cuid())
  codigo                String   @unique
  descricao             String?
  tipoDesconto          String   @default("percentual") // percentual | fixo
  valor                 Float
  valorMinimo           Float    @default(0)
  limiteUsos            Int?
  limitePorCliente      Int      @default(1)
  inicioEm              DateTime?
  fimEm                 DateTime?
  ativo                  Boolean  @default(true)
  influenciadorNome     String?
  influenciadorContato  String?
  comissaoPercentual    Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  vendas                Venda[]
  usos                   CupomUso[]

  @@index([ativo, fimEm])
}

model CupomUso {
  id         String   @id @default(cuid())
  cupomId    String
  vendaId    String   @unique
  clienteId  String?
  codigo     String
  desconto   Float
  comissao   Float    @default(0)
  createdAt  DateTime @default(now())
  cupom      Cupom    @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  venda      Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([cupomId, createdAt])
  @@index([clienteId])
}

model Notificacao {
  id        String   @id @default(cuid())
  tipo      String
  destino   String
  mensagem  String
  processoId String?
  status    String   @default("pendente")
  createdAt DateTime @default(now())
  enviadaEm DateTime?
  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
}

model Integracao {
  id        String   @id @default(cuid())
  plataforma String
  ativo     Boolean  @default(false)
  token     String?
  sellerId  String?
  domain    String?
  ultimaSync DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MercadoLivreConnection {
  id                  String   @id @default("matilha-prado")
  sellerId            String
  accessToken         String
  refreshToken        String
  accessTokenExpiresAt DateTime
  connectedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ConfiguracaoFrete {
  id String @id @default(cuid())
  entregaPropriaAtiva Boolean @default(true)
  entregaPropriaValor Float @default(20.00)
  entregaPropriaPrazo String @default("Até 4 horas")
  entregaPropriaCepInicial String @default("02000-000")
  entregaPropriaCepFinal String @default("02999-999")
  sedexAtivo Boolean @default(false)
  sedexPrazo String @default("3-5 dias úteis")
  retiradaAtiva Boolean @default(true)
  retiradaPrazo String @default("Pronto para retirada em até 4 horas")
  retiradaEndereco String @default("Av. Água Fria, 1647 — Santana, São Paulo/SP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoPagamento {
  id String @id @default(cuid())
  mercadoPagoAtivo Boolean @default(true)
  mercadoPagoAccessToken String?
  mercadoPagoPublicKey String?
  mercadoPagoSandbox Boolean @default(false)
  pixAtivo Boolean @default(true)
  cartaoAtivo Boolean @default(true)
  boletoAtivo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInvitation {
  id          String   @id @default(cuid())
  email       String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model AuthAttempt {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ClientInvitation {
  id String @id @default(cuid())
  siggmaCliCod Int? @unique // referencia legada, não consultada
  clienteId String? @unique // cadastro oficial do ERP Matilha Prado
  nome String
  email String
  telefone String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  issuedAt DateTime @default(now())
  createdById String
  emailStatus String @default("pending")
  providerId String?

  @@index([email])
}

// Portal additions are isolated from ERP records and existing checkout tables.
model CustomerPreference {
  id String @id @default(cuid())
  clienteId String
  produtoId String
  favorite Boolean @default(false)
  restock Boolean @default(false)
  reminderAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  @@unique([clienteId, produtoId])
  @@index([clienteId, reminderAt])
}

model CustomerPetProfile {
  id String @id @default(cuid())
  clienteId String
  petKey String
  photo String?
  size String?
  birthday String?
  notes String?
  updatedAt DateTime @updatedAt
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, petKey])
}

model ProductReview {
  id String @id @default(cuid())
  clienteId String
  produtoId String
  vendaId String
  rating Int
  comment String
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  @@unique([clienteId, produtoId])
  @@index([produtoId, hidden])
}

model BookingRequest {
  id String @id @default(cuid())
  clienteId String
  petKey String
  petName String
  service String
  desiredAt DateTime
  notes String?
  status String @default("solicitado")
  confirmedAt DateTime?
  confirmationRef String?
  reply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@unique([clienteId, petKey, desiredAt])
  @@index([status, desiredAt])
}

model LoyaltyConfig {
  id String @id @default("default")
  active Boolean @default(false)
  startsAt DateTime @default(now())
  spendCentsPerPoint Int @default(100)
  rewardPoints Int @default(100)
  rewardCents Int @default(1000)
  updatedAt DateTime @updatedAt
}

model LoyaltyRedemption {
  id String @id @default(cuid())
  clienteId String
  points Int
  couponCode String @unique
  createdAt DateTime @default(now())
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@index([clienteId])
}


// ERP Matilha Prado: configuração do emitente e registro fiscal independentes do Zetta.
// Emissão real será habilitada apenas após integração homologada com SEFAZ/provedor.
model ConfiguracaoFiscal {
  id String @id @default("matilha-prado")
  razaoSocial String?
  nomeFantasia String?
  cnpj String?
  inscricaoEstadual String?
  regimeTributario String?
  // CRT 1: apuração mensal no PGDAS-D / DAS. Nunca ratear Anexo I na NF-e.
  apuracaoTributaria String @default("PENDENTE_VALIDACAO")
  logradouro String?
  numeroEndereco String?
  bairro String?
  cidade String?
  uf String?
  cep String?
  codigoMunicipio String?
  serieNfe Int @default(1)
  ambiente String @default("homologacao")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Primeira NF-e de teste, isolada de Venda/NotaFiscal de produção.
// Nunca usar estes registros para movimentar estoque ou contabilizar receita.
model NfeHomologacao {
  id String @id @default(cuid())
  serie Int
  numero Int
  chave String @unique
  ambiente Int @default(2)
  status String @default("preparada")
  produtoId String
  quantidade Int
  valorUnitario Float
  xmlAssinado String @db.Text
  xmlAutorizado String? @db.Text
  recibo String?
  protocolo String?
  codigoSefaz Int?
  motivoSefaz String?
  enviadaEm DateTime?
  autorizadaEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serie, numero])
  @@index([status, createdAt])
}

model NotaFiscal {
  id String @id @default(cuid())
  vendaId String @unique
  modelo String @default("55")
  status String @default("rascunho")
  numero Int?
  serie Int?
  chaveAcesso String? @unique
  protocolo String?
  xmlAutorizado String? @db.Text
  danfeUrl String?
  emissor String? // mercado_livre ou emissor externo
  emissorDocumentoId String?
  emissaoSolicitadaEm DateTime?
  consultadaEm DateTime?
  erro String?
  autorizadaEm DateTime?
  canceladaEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}


// Eventos permanentes de auditoria da agenda própria.
model AgendaEvento {
  id String @id @default(cuid())
  agendamentoId String
  acao String
  autorId String
  detalhe String?
  createdAt DateTime @default(now())

  @@index([agendamentoId, createdAt])
}

/**
 * Regra fiscal de referência revisada para uma operação específica.
 * NÃO é um cálculo oficial de tributos, nem autoriza emissão de notas.
 * Inicialmente apenas revenda interna de SP a consumidor final não contribuinte.
 */
model RegraFiscalAprovada {
  id String @id @default(cuid())
  ncm String
  cfop String
  ufDestino String @default("SP")
  origem String
  indicadorIE String @default("9")
  csosn String
  cest String?
  pisCst String
  cofinsCst String
  ipiCst String?
  ibsCbsCst String?
  ibsCbsClassTrib String?
  aliquotaIcmsSt Float?
  aliquotaPis Float?
  aliquotaCofins Float?
  aliquotaIpi Float?
  aliquotaFcpSt Float?
  aliquotaIbsUf Float?
  aliquotaIbsMun Float?
  aliquotaCbs Float?
  contadorResponsavel String
  referencia String
  observacoes String?
  vigenteDesde DateTime?
  vigenteAte DateTime?
  ativo Boolean @default(true)
  aprovadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([ncm, cfop, ufDestino, origem, indicadorIE])
  @@index([ncm, ufDestino, ativo])
}

model ImportacaoFiscalProduto {
  id String @id @default(cuid())
  produtoId String
  sku String?
  fonte String
  arquivo String
  hashArquivo String
  linha Int
  camposAlterados String
  ncmAnterior String?
  ncmNovo String?
  cestAnterior String?
  cestNovo String?
  gtinAnterior String?
  gtinNovo String?
  origemAnterior String?
  origemNova String?
  criadoEm DateTime @default(now())

  @@index([produtoId, criadoEm])
  @@index([hashArquivo])
}


/**
 * Configuracao INTERNA dos servicos esteticos confirmados pela Matilha Prado.
 * Campos opcionais ficam vazios ate a resposta da equipe; valores nao sao
 * automaticamente publicados nem usados para calculo fiscal/agendamento.
 */
model ServicoEsteticoConfig {
  chave String @id
  precoCentavos Int?
  duracaoMinutos Int?
  regrasPreco String? @db.Text
  observacoes String? @db.Text
  confirmado Boolean @default(false)
  updatedAt DateTime @updatedAt
}


// Portal do cliente: conteúdo editorial público para contas autenticadas.
// As tabelas novas não modificam vendas, NF-e ou os dados oficiais do Siggma.
model PortalArticle {
  id String @id @default(cuid())
  title String
  category String
  summary String
  body String @db.Text
  imageUrl String?
  productId String?
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favorites PortalArticleFavorite[]
  @@index([published, createdAt])
}

model PortalArticleFavorite {
  id String @id @default(cuid())
  articleId String
  clienteId String
  createdAt DateTime @default(now())
  article PortalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@unique([articleId, clienteId])
  @@index([clienteId])
}

// Fotos guardadas no banco próprio, nunca em URLs públicas nem no Zetta.
// kind: diario | vacina_documento | banho_antes | banho_depois
model PortalPetMemory {
  id String @id @default(cuid())
  clienteId String
  petKey String
  kind String
  title String
  notes String? @db.Text
  weightKg Float?
  imageData String? @db.Text
  eventAt DateTime @default(now())
  nextAt DateTime?
  processoId String?
  createdByAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([clienteId, petKey, eventAt])
  @@index([processoId])
}

model PortalClientPreferences {
  clienteId String @id
  remindersInApp Boolean @default(true)
  remindersEmail Boolean @default(false)
  remindersWhatsapp Boolean @default(false)
  marketingEmail Boolean @default(false)
  marketingWhatsapp Boolean @default(false)
  groomingPhotoConsent Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model PortalCarePlan {
  id String @id @default(cuid())
  title String
  description String
  sessions Int
  durationDays Int @default(30)
  priceCents Int
  active Boolean @default(false)
  createdAt DateTime @default(now())
  requests PortalCarePlanRequest[]
}

model PortalCarePlanRequest {
  id String @id @default(cuid())
  clienteId String
  planId String
  petKey String
  status String @default("solicitado")
  providerSubscriptionId String? @unique
  providerCheckoutUrl String?
  providerStatus String?
  providerSyncedAt DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  sessionsUsed Int @default(0)
  paymentReference String?
  approvedByUserId String?
  approvedAt DateTime?
  startsAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  plan PortalCarePlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  uses PortalCarePlanUse[]
  payments PortalCarePlanPayment[]
  @@index([clienteId, status])
}

model PortalReferral {
  id String @id @default(cuid())
  clienteId String @unique
  code String @unique
  createdAt DateTime @default(now())
}

model PortalReferralClaim {
  id String @id @default(cuid())
  inviterId String
  invitedId String @unique
  code String
  status String @default("aguardando_compra")
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  verifiedByUserId String?
  rewardCouponId String?
  @@index([inviterId, status])
}

model PortalGiftRequest {
  id String @id @default(cuid())
  clienteId String
  recipientName String
  recipientEmail String?
  message String?
  amountCents Int
  status String @default("solicitado")
  voucherCode String? @unique
  balanceCents Int @default(0)
  paidAt DateTime?
  paymentReference String?
  approvedByUserId String?
  createdAt DateTime @default(now())
  redemptions PortalGiftRedemption[]
  @@index([clienteId, status])
}

model PortalPetFamilyInvite {
  id String @id @default(cuid())
  ownerClienteId String
  petKey String
  recipientEmail String
  recipientClienteId String?
  status String @default("pendente")
  createdAt DateTime @default(now())
  respondedAt DateTime?
  @@unique([ownerClienteId, petKey, recipientEmail])
  @@index([recipientEmail, status])
}


// Baixa idempotente: uma prestação concluída de atendimento para um pacote.
model PortalCarePlanUse {
  id String @id @default(cuid())
  requestId String
  processoId String @unique
  createdAt DateTime @default(now())
  request PortalCarePlanRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId])
}


// Mercado Pago /preapproval and its independently verified paid installments.
model PortalCarePlanPayment {
  id String @id @default(cuid())
  requestId String
  providerPaymentId String @unique
  status String
  paidAt DateTime?
  amountCents Int
  createdAt DateTime @default(now())
  request PortalCarePlanRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId, paidAt])
}

// Credit is a payment method, never a fiscal discount.
model PortalGiftRedemption {
  id String @id @default(cuid())
  giftId String
  saleId String @unique
  amountCents Int
  status String @default("reservado")
  createdAt DateTime @default(now())
  gift PortalGiftRequest @relation(fields: [giftId], references: [id], onDelete: Restrict)
  sale Venda @relation(fields: [saleId], references: [id], onDelete: Restrict)
  @@index([giftId, status])
}

model PortalReferralConfig {
  id String @id @default("default")
  active Boolean @default(false)
  awardCents Int @default(0)
  minimumPurchaseCents Int @default(0)
  validDays Int @default(30)
  updatedAt DateTime @updatedAt
}

// Customer opt-in is stored in PortalClientPreferences.
// Idempotent queue; WhatsApp only uses preapproved utility templates.
model PortalMessageDelivery {
  id String @id @default(cuid())
  uniqueKey String @unique
  clienteId String
  channel String
  kind String
  templateName String?
  text String
  status String @default("pendente")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  providerId String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([clienteId, createdAt])
}

// Binary PDF is never returned by the general portal JSON response.
model PortalPetDocument {
  id String @id @default(cuid())
  clienteId String
  petKey String
  title String
  fileName String
  fileData String @db.Text
  sizeBytes Int
  sha256 String
  createdAt DateTime @default(now())
  @@index([clienteId, petKey])
}


// Execução periódica com lease para evitar syncs simultâneos entre cron e painel.
model MarketplaceSyncRun {
  id String @id @default("marketplaces")
  leaseToken String?
  leaseUntil DateTime?
  status String @default("never")
  lastStartedAt DateTime?
  lastFinishedAt DateTime?
  lastSuccessAt DateTime?
  lastMlUpdated Int @default(0)
  lastMlActivated Int @default(0)
  lastLocalPublished Int @default(0)
  lastLocalHidden Int @default(0)
  lastBlockedListings Int @default(0)
  lastAmazonUpdated Int @default(0)
  lastSalesImported Int @default(0)
  lastErrors String? @db.Text
  updatedAt DateTime @updatedAt
}


// Permissões negadas e restrições da listagem precisam ficar visíveis e
// não devem gerar tentativas repetidas em toda execução do cron.
model MarketplaceStockIssue {
  id String @id
  channel String
  productId String
  title String
  category String
  error String @db.Text
  retryAfter DateTime?
  resolvedAt DateTime?
  firstSeenAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([resolvedAt,retryAfter])
}


// Registro auditável de conferências manuais do estoque físico integrado.
model MarketplaceStockConfirmation {
  id String @id @default(cuid())
  productId String
  mlItemId String
  adminId String
  previousStock Int
  confirmedStock Int
  marketplaceStockSeen Int
  createdAt DateTime @default(now())
  @@index([productId,createdAt])
}


// Auditoria de conclusão manual de entregas LOCAIS, nunca de remessas
// confirmadas externamente por Mercado Livre/Amazon.
model EntregaLoteAuditoria {
  id String @id @default(cuid())
  adminId String
  pedidoIds Json
  quantidade Int
  acao String @default("entregue")
  createdAt DateTime @default(now())
  @@index([createdAt])
}


// Formulários privados de banho/tosa: um par de fichas por atendimento.
// Check-in congelado após envio ao tutor; aceite e check-out têm trilha de auditoria.
model AtendimentoFicha {
  id String @id @default(cuid())
  processoId String @unique
  petId String
  clienteId String
  checkin Json?
  checkinStatus String @default("rascunho")
  checkinById String?
  checkinSubmittedAt DateTime?
  tutorAceiteAt DateTime?
  tutorAceiteUserId String?
  tutorAceiteNome String?
  tutorAceiteVersao String?
  tutorAceiteHash String?
  tutorAceiteIpHash String?
  checkout Json?
  checkoutById String?
  checkoutFinalizadoAt DateTime?
  // Ciência do tutor sobre o check-out, independente da autorização de entrada.
  checkoutAceiteStatus String @default("nao_solicitado")
  checkoutAceiteAt DateTime?
  checkoutAceiteUserId String?
  checkoutAceiteNome String?
  checkoutAceiteVersao String?
  checkoutAceiteHash String?
  checkoutAceiteIpHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  processo Processo @relation(fields:[processoId],references:[id],onDelete:Restrict)
  eventos AtendimentoFichaEvento[]
  @@index([clienteId, petId, createdAt])
  @@index([checkinStatus, checkinSubmittedAt])
}

model AtendimentoFichaEvento {
  id String @id @default(cuid())
  fichaId String
  actorId String
  acao String
  resumo String?
  createdAt DateTime @default(now())
  ficha AtendimentoFicha @relation(fields:[fichaId],references:[id],onDelete:Restrict)
  @@index([fichaId, createdAt])
}

/**
 * Fotografias enviadas pelo gestor da Matilha Prado.
 * Persistência independente do disco temporário das funções Vercel.
 * O produto guarda apenas a URL da imagem e o estoque permanece intocado.
 */
model ProdutoImagem {
  id        String   @id @default(cuid())
  conteudo  Bytes    @db.ByteA
  tipo      String
  createdAt DateTime @default(now())
}
