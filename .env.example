# Banco interno do Hub (autenticação/configuração). Em produção, use uma base/schema
# dedicado e autorizado pelo cliente. Não aponte o Prisma para o schema central do ERP.
DATABASE_URL=""

# Gere uma chave aleatória com pelo menos 32 caracteres.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Código hexadecimal de 64 caracteres usado somente para ativar o primeiro ADMIN.
# Depois que o primeiro administrador existir, novos admins usam convites normais.
ADMIN_BOOTSTRAP_CODE=""

# Mercado Pago — Checkout Transparente (Orders API)
# Access Token é secreto e deve existir apenas no servidor/Vercel.
MERCADO_PAGO_ACCESS_TOKEN=""
# Public Key pode ser exposta ao navegador para tokenização via MercadoPago.js.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""
# Assinatura gerada ao configurar o webhook "Order (Mercado Pago)".
MERCADO_PAGO_WEBHOOK_SECRET=""

# Siggma / Zettabrasil
# Ambiente de homologação confirmado para a Matilha Prado.
SIGGMA_BASE_URL="https://virtuais.zettabrasil.com.br/siggma-3860testesapi"
SIGGMA_CLIENT_ID="emp_3860"
SIGGMA_CLIENT_SECRET=""
# Empresa/filial confirmada pela Zettabrasil.
SIGGMA_EMP="3860-1"
# A última orientação formal da Zettabrasil mantém criação de agendamento fora
# do escopo atual. Deixe false. Só habilite após liberação oficial e recebimento
# do expediente/catálogo reais; nunca use os IDs ilustrativos da documentação.
SIGGMA_AGENDAMENTO_DIRETO_ENABLED="false"
SIGGMA_AGENDAMENTO_EXPEDIENTE_ID=""
# Catálogo autorizado no portal. Ex.: [{"id":101,"nome":"Banho"}]
SIGGMA_AGENDAMENTO_SERVICOS_JSON="[]"
# Pedidos usam o endpoint oficial POST /api/pedidos-integracao/importar.

# Bridge Oracle -> Zettabrasil
# O acesso direto ao PostgreSQL deve existir apenas na Oracle VM com o IP liberado.
SIGGMA_DB_HOST="pg18-ha.zettabrasil.cloud"
SIGGMA_DB_PORT="5734"
SIGGMA_DB_NAME="EMP_3860_1"
SIGGMA_DB_USER="ext_raphael_santos"
SIGGMA_DB_PASSWORD=""
SIGGMA_DB_SSLMODE="disable"

# Vercel -> Oracle VM. Preencher somente depois que integracao.matilhaprado.com.br
# estiver com DNS e HTTPS válidos. O segredo deve ser igual ao BRIDGE_API_SECRET da VM.
INTEGRATION_BRIDGE_URL=""
INTEGRATION_BRIDGE_SECRET=""


# Google Maps / Places — avaliações públicas na landing page
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID="ChIJM21vIv33zpQRZ4M0vWnu090"
# Convites individuais de clientes. Configure o remetente em um domínio verificado no Resend.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
INVITATION_EMAIL_REPLY_TO=matilhaprado@gmail.com
APP_URL=https://www.matilhaprado.com.br

# Mercado Livre OAuth. Use uma chave AES aleatória de 32 bytes (64 caracteres hexadecimais).
MERCADO_LIVRE_CLIENT_ID=""
MERCADO_LIVRE_CLIENT_SECRET=""
MERCADO_LIVRE_REDIRECT_URI="https://www.matilhaprado.com.br/api/integracoes/mercado-livre/callback"
MERCADO_LIVRE_TOKEN_ENCRYPTION_KEY=""


# Loja 2.0 — carrossel promocional.
# URLs públicas separadas por vírgula. Deixe vazio para ocultar o carrossel.
NEXT_PUBLIC_STORE_CAROUSEL_IMAGES=""
NEXT_PUBLIC_STORE_CAROUSEL_AUTOPLAY_MS="6500"
